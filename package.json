{
  "name": "obcina",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --project demo-obcina",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-obcina \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "prepare": "husky",
    "build-and-preview": "npm run build && vite preview",
    "e2e:serve": "npm run seed && vite build --mode emulators && vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "images": "tsx scripts/images.ts",
    "seed": "tsx scripts/seed.ts",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "chrome-launcher": "^1.2.3",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --deny-warnings",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "protobufjs": false,
    "re2": false,
    "@firebase/util": false,
    "fsevents": false,
    "esbuild": false
  }
}
