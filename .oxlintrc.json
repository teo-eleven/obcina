{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/seedProducts"],
            "message": "Seed data is for the seed script and tests only; the app reads products from Firestore."
          }
        ]
      }
    ],
    "no-duplicate-imports": "error"
  },
  "overrides": [
    {
      "files": [
        "src/constants/seedProducts.test.ts",
        "src/constants/productImages.test.ts",
        "src/utils/catalog.test.ts",
        "src/services/productsRepository.test.ts",
        "src/pages/ProductPage/ProductPage.test.tsx",
        "src/routes.test.tsx",
        "src/pages/CategoryPage/CategoryPage.test.tsx",
        "src/components/ProductCard.test.tsx",
        "scripts/**",
        "firebase/**",
        "e2e/catalog.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
