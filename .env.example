# Copiază în .env.local și completează. Nu pune niciodată .env.local pe GitHub.

# Firebase (config public de client — din Firebase Console > Project settings > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Stripe — DOAR chei de test (sk_test_..., whsec_...). Se setează și în Vercel > Environment Variables.
# Fără prefix VITE_: rămân pe server, nu ajung niciodată în browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
