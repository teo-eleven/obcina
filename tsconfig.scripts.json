{
  // Node scripts written in TypeScript. Bundler-style resolution because they import src/ files,
  // which use extensionless imports. images.ts runs on plain Node (type stripping), so its src/
  // imports must stay type-only; seed.ts runs on tsx (ADR 0007), which resolves value imports too.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["scripts/**/*.ts"]
}
